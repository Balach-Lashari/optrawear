{
  "$description": "Optrawear design tokens (W3C Design Tokens format). Source of truth; mirrored in tokens.css (Tailwind v4 @theme) and tokens.ts. Values sampled 1:1 from doc/reference/design/Frame.png.",
  "color": {
    "$type": "color",
    "cream": { "$value": "#fffae5", "$description": "Page ground" },
    "cream-sunken": { "$value": "#f7f1d8", "$description": "Order summary rail" },
    "cream-tint": { "$value": "#f4edd2", "$description": "Image wells, status tags, hover wash" },
    "cream-press": { "$value": "#eae6d5", "$description": "Selected account-nav row" },
    "board": { "$value": "#e7e2d5", "$description": "Presentation board only; never on site" },
    "ink": { "$value": "#191919", "$description": "Text, primary button, announcement bar, house-line panel" },
    "ink-soft": { "$value": "#4d4c46", "$description": "Body copy (8.2:1 on cream)" },
    "ink-muted": { "$value": "#6f6d64", "$description": "Meta, labels, secondary nav (5.0:1 on cream)" },
    "ink-faint": { "$value": "#76736a", "$description": "Facet counts, reference codes (4.5:1 on cream)" },
    "line": { "$value": "#e2decd", "$description": "Hairline rules and dividers" },
    "line-strong": { "$value": "#c9c6b7", "$description": "Input, panel and quiet-button borders" },
    "slate": { "$value": "#2a3138", "$description": "Hero ground, avatar" },
    "slate-deep": { "$value": "#262b31", "$description": "House-line image ground" },
    "slate-pad": { "$value": "#474d52", "$description": "Pad fill in the fit diagram" },
    "finish-titanium": { "$value": "#b9b4a8", "$description": "Swatch: brushed titanium" },
    "finish-graphite": { "$value": "#3d4249", "$description": "Swatch: graphite" },
    "finish-champagne": { "$value": "#d8c9a6", "$description": "Swatch: champagne" },
    "danger": { "$value": "#9b2c1f", "$description": "Form errors (extension; not on the board)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": { "$value": ["Newsreader", "Footlight MT", "Georgia", "serif"], "$description": "Display + headings. Newsreader stands in for Footlight MT." },
      "sans": { "$value": ["Archivo", "Neue Haas Grotesk Text", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Text + UI. Archivo stands in for Haas Grotesk." }
    }
  },
  "text": {
    "display-xl": { "size": { "$type": "dimension", "$value": "96px" }, "lineHeight": 0.84, "letterSpacing": "-0.025em", "family": "serif", "weight": 300, "$description": "Home hero" },
    "display-lg": { "size": { "$type": "dimension", "$value": "64px" }, "lineHeight": 1, "letterSpacing": "-0.02em", "family": "serif", "weight": 400, "$description": "Collection + product titles" },
    "display-md": { "size": { "$type": "dimension", "$value": "56px" }, "lineHeight": 1, "letterSpacing": "-0.02em", "family": "serif", "weight": 400, "$description": "Bag, houses, account titles" },
    "display-sm": { "size": { "$type": "dimension", "$value": "48px" }, "lineHeight": 1.04, "letterSpacing": "-0.015em", "family": "serif", "weight": 400, "$description": "House-line banner" },
    "heading-xl": { "size": { "$type": "dimension", "$value": "44px" }, "lineHeight": 1.05, "letterSpacing": "-0.015em", "family": "serif", "weight": 400, "$description": "Editorial headline" },
    "heading-lg": { "size": { "$type": "dimension", "$value": "32px" }, "lineHeight": 1.1, "letterSpacing": "-0.01em", "family": "serif", "weight": 400, "$description": "Totals, fit-card figures" },
    "heading-md": { "size": { "$type": "dimension", "$value": "24px" }, "lineHeight": 1.2, "family": "serif", "weight": 400, "$description": "Section titles, PDP price, bag names" },
    "heading-sm": { "size": { "$type": "dimension", "$value": "20px" }, "lineHeight": 1.25, "family": "serif", "weight": 400, "$description": "Card names, panel titles" },
    "heading-xs": { "size": { "$type": "dimension", "$value": "17px" }, "lineHeight": 1.3, "family": "serif", "weight": 400, "$description": "Promise strip, coverage card" },
    "body-lg": { "size": { "$type": "dimension", "$value": "15px" }, "lineHeight": 1.7, "family": "sans", "weight": 400, "$description": "Hero + collection intros" },
    "body": { "size": { "$type": "dimension", "$value": "14px" }, "lineHeight": 1.72, "family": "sans", "weight": 400, "$description": "Default copy, nav, controls" },
    "small": { "size": { "$type": "dimension", "$value": "13px" }, "lineHeight": 1.5, "family": "sans", "weight": 400, "$description": "Buttons, table cells" },
    "meta": { "size": { "$type": "dimension", "$value": "12px" }, "lineHeight": 1.5, "family": "sans", "weight": 400, "$description": "Meta lines, captions" },
    "label": { "size": { "$type": "dimension", "$value": "11px" }, "lineHeight": 1.3, "letterSpacing": "0.16em", "family": "sans", "weight": 500, "transform": "uppercase", "$description": "Tracked capitals" },
    "micro": { "size": { "$type": "dimension", "$value": "10px" }, "lineHeight": 1.3, "letterSpacing": "0.12em", "family": "sans", "weight": 400, "$description": "Facet counts, reference codes, tags" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "4px", "$description": "Tailwind --spacing; every gap is a multiple" }
  },
  "layout": {
    "$type": "dimension",
    "page": { "$value": "1344px", "$description": "Content width at 1440 (48px gutters)" },
    "prose": { "$value": "576px", "$description": "Intro copy measure" },
    "gutter-sm": { "$value": "16px" },
    "gutter-md": { "$value": "32px" },
    "gutter-xl": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "2px", "$description": "Buttons, inputs, tags, pills" },
    "sm": { "$value": "3px", "$description": "Boxed panels (diagram, prescription)" }
  },
  "motion": {
    "ease-out": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "200ms" },
    "duration-slow": { "$type": "duration", "$value": "320ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "board": { "$value": "1440px", "$description": "The reference mockups" }
  }
}
